server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    add_header Cache-Control "no-cache";

    # The browser talks to Ditto through this proxy: same origin, and the
    # Ditto password stays on the server side.
    location /ditto/ {
        proxy_pass http://ditto-nginx:80/;
        proxy_set_header Authorization "Basic ${DITTO_BASIC_AUTH}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
